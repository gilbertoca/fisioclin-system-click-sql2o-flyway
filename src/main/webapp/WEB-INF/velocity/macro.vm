#**
 * Css menu macro.
 *
 * Iterates Menu#getChildren and uses Menu#getHref, which already
 * includes the context path.
 *
 * Visibility of auth-sensitive items is driven by $authenticated,
 * exposed by BorderPage#onInit().
 *#
#macro(renderMenu $menu)
  #foreach($item in $menu.children)
    #if($authenticated)
      <li>
        #if($item.hasChildren())
          <!-- Item pai do dropdown -->
          <a href="#">$item.label</a>
          <!-- Submenu semântico que o Bahunya transforma em dropdown automático -->
          <ul>
            #renderMenu($item)
          </ul>
        #else
          <!-- Item de link comum -->
          <a href="$item.href">$item.label</a>
        #end
      </li>
    #end
  #end
#end
